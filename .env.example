# Shared
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379

# Agents only
LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
ANTHROPIC_API_KEY=
INCIDENT_TOKEN_BUDGET=20000
TOOL_MODE=live

# NVIDIA NIM (cloud inference — eliminates local Ollama resource usage)
# Get a free API key at https://build.nvidia.com (no credit card required)
# To switch: set LLM_BACKEND=nim and NIM_API_KEY=<your-key>, then stop Ollama
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_SPECIALIST_MODEL=meta/llama-3.1-8b-instruct
NIM_SYNTHESIZER_MODEL=meta/llama-3.1-70b-instruct
NIM_TIMEOUT_S=30.0
